{
  "name": "feel-better",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "pnpm --filter api-core db:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ],
    "packageExtensions": {
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "next": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@clerk/nextjs": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@clerk/clerk-react": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "sonner": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "radix-ui": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "stream-chat-react": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "react-hook-form": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@hookform/resolvers": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@tanstack/react-query": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@tanstack/react-query-devtools": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    }
  }
}
