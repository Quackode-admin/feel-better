# =============================================================================
# Feel Better — Variables de entorno requeridas
# Copia este archivo a .env.local (nunca commitees .env.local)
# =============================================================================

# Base de datos (Railway PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/feel_better

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://XXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=feel-better-dev
R2_PUBLIC_URL=

# Auth — mínimo 32 caracteres
JWT_SECRET=
JWT_REFRESH_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_STREAM_API_KEY=

# Entorno
NODE_ENV=development
