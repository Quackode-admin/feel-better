# =============================================================================
# Feel Better — Variables de entorno requeridas
# Copia este archivo a .env.local (nunca commitees .env.local)
# =============================================================================

# Base de datos (Railway PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/feel_better

# ─── Clerk (autenticación) ────────────────────────────────────────────────────
# Obtener en: https://dashboard.clerk.com → tu app → API Keys

# Backend (api-core) — NUNCA exponer al frontend
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx  # Clerk Dashboard → Webhooks
CLERK_DOMAIN=clerk.xxxxxxxxx.lcl.dev             # o tu dominio de Clerk en prod

# Frontend (apps/web) — prefijo NEXT_PUBLIC_ = se expone al browser
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://XXXX.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=feel-better-dev
R2_PUBLIC_URL=

# ─── Stream (chat) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STREAM_API_KEY=
